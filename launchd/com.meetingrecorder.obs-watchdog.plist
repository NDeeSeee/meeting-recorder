<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.meetingrecorder.obs-watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/USERNAME/.local/bin/obs-watchdog</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<false/>
	<!-- obs-watchdog backgrounds a blocking `osascript display alert` when it
	     gives up after repeated restarts; without this, launchd kills the
	     job's process group on exit and the alert vanishes immediately. -->
	<key>AbandonProcessGroup</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/USERNAME/Library/Logs/obs-watchdog.stderr.log</string>
</dict>
</plist>
